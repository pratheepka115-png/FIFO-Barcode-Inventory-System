{
  "name": "fifo-barcode-inventory-system",
  "version": "1.0.0",
  "description": "FIFO Barcode Inventory System",
  "author": "FIFO Inventory",
  "private": true,
  "main": "electron.cjs",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.fifo.inventory",
    "productName": "FIFO Barcode Inventory System",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron.cjs",
      "package.json",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis"
    }
  }
}